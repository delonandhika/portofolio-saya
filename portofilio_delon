   1. CORE CONFIGURATION (MIDNIGHT NAVY)
   ========================================= */
@import url('https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;600;800&display=swap');

:root {
    --clr-night: #0a0f1d;
    --clr-navy: #16213e;
    --clr-navy-light: #1f2e54;
    --clr-primary: #4cc9f0;
    --clr-accent: #7209b7;
    --clr-text: #e2e8f0;
    --clr-muted: #94a3b8;
    --glass: rgba(22, 33, 62, 0.8);
    --shadow: 0 20px 50px rgba(0, 0, 0, 0.5);
    --transition: all 0.4s cubic-bezier(0.4, 0, 0.2, 1);
}

* {
    margin: 0;
    padding: 0;
    box-sizing: border-box;
    font-family: 'Plus Jakarta Sans', sans-serif;
}

body {
    background: linear-gradient(135deg, var(--clr-night) 0%, var(--clr-navy) 100%);
    background-attachment: fixed;
    color: var(--clr-text);
    line-height: 1.6;
    overflow-x: hidden;
}

.container {
    max-width: 1200px;
    margin: 0 auto;
    padding: 0 2rem;
}

/* =========================================
   2. NAVIGATION (CONSISTENT)
   ========================================= */
nav {
    display: flex;
    justify-content: space-around;
    align-items: center;
    margin: 1rem auto;
    width: 90%;
    height: 70px;
    background: var(--glass);
    backdrop-filter: blur(15px);
    border: 1px solid rgba(255, 255, 255, 0.1);
    border-radius: 20px;
    position: sticky;
    top: 20px;
    z-index: 1000;
    box-shadow: var(--shadow);
}

.logo { font-weight: 800; font-size: 1.5rem; color: var(--clr-primary); }
.nav-links { display: flex; gap: 1rem; list-style: none; }
.nav-links a {
    text-decoration: none;
    color: var(--clr-text);
    font-weight: 600;
    padding: 0.5rem 1rem;
    border-radius: 12px;
    transition: var(--transition);
}
.nav-links a:hover { background: var(--clr-primary); color: var(--clr-night); }

/* =========================================
   3. HOME PAGE - HERO (ENHANCED)
   ========================================= */
.hero {
    padding: 10rem 0;
    text-align: center;
    position: relative;
    /* Efek gradasi cahaya abstrak di background */
    background: radial-gradient(circle at 10% 20%, rgba(76, 201, 240, 0.15) 0%, transparent 40%),
                radial-gradient(circle at 90% 80%, rgba(114, 9, 183, 0.2) 0%, transparent 40%);
}

.hero h1 { 
    font-size: 5rem; 
    font-weight: 800; 
    letter-spacing: -3px;
    line-height: 1.1;
    margin-bottom: 2rem; 
    animation: fadeInUp 0.8s ease;
}

.hero h1 span { 
    background: linear-gradient(90deg, var(--clr-primary), #b5179e); 
    -webkit-background-clip: text; 
    -webkit-text-fill-color: transparent;
    filter: drop-shadow(0 0 10px rgba(76, 201, 240, 0.3));
}

.hero p {
    font-size: 1.25rem;
    color: var(--clr-muted);
    max-width: 700px;
    margin: 0 auto 3rem;
    animation: fadeInUp 1s ease;
}

/* Home Stats Bar (Floating & Premium) */
.stats-wrapper {
    display: flex;
    justify-content: center;
    margin-top: -5rem;
    position: relative;
    z-index: 10;
}

.stats-bar {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    background: var(--glass);
    backdrop-filter: blur(20px);
    padding: 3rem;
    border-radius: 35px;
    width: 85%;
    border: 1px solid rgba(255, 255, 255, 0.1);
    box-shadow: var(--shadow);
}

.stat-item h3 { font-size: 3rem; color: var(--clr-primary); margin-bottom: 5px; }
.stat-item p { font-size: 0.9rem; text-transform: uppercase; letter-spacing: 2px; color: var(--clr-muted); }

/* Focus Area (Home Content) */
.focus-area { padding: 8rem 0; }
.section-title { text-align: center; font-size: 3rem; margin-bottom: 4rem; }

.focus-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(300px, 1fr));
    gap: 2.5rem;
}

.focus-card {
    background: rgba(255, 255, 255, 0.03);
    padding: 3rem 2rem;
    border-radius: 30px;
    text-align: center;
    border: 1px solid rgba(255, 255, 255, 0.05);
    transition: var(--transition);
}

.focus-card:hover {
    background: var(--clr-navy-light);
    transform: translateY(-15px);
    border-color: var(--clr-primary);
    box-shadow: 0 15px 30px rgba(0,0,0,0.3);
}

.icon-box {
    font-size: 2.5rem;
    color: var(--clr-primary);
    margin-bottom: 1.5rem;
}

/* =========================================
   4. ABOUT, PROJECTS & CONTACT (CONSISTENT)
   ========================================= */
.about-page { padding: 6rem 0; }

.about-header {
    display: grid;
    grid-template-columns: 1fr 1.5fr;
    gap: 4rem;
    align-items: center;
    background: rgba(255, 255, 255, 0.03);
    backdrop-filter: blur(20px);
    padding: 4rem;
    border-radius: 40px;
    border: 1px solid rgba(255, 255, 255, 0.1);
    box-shadow: var(--shadow);
    position: relative;
}

.about-img { position: relative; perspective: 1000px; }
.about-img img {
    width: 100%;
    border-radius: 30px;
    border: 4px solid rgba(255, 255, 255, 0.05);
    transition: var(--transition);
    z-index: 2;
    position: relative;
}

/* Efek Glow di belakang foto */
.about-img::before {
    content: '';
    position: absolute;
    width: 100%; height: 100%;
    top: 20px; left: 20px;
    background: var(--clr-primary);
    border-radius: 30px;
    z-index: 0;
    opacity: 0.1;
    transition: var(--transition);
}

.about-img:hover img { transform: translateY(-10px) rotateY(-5px); border-color: var(--clr-primary); }
.about-img:hover::before { transform: translate(10px, 10px); opacity: 0.2; }

.about-text h2 { font-size: 3.5rem; margin-bottom: 1.5rem; font-weight: 800; line-height: 1; }
.about-text h2 span { color: var(--clr-primary); text-shadow: 0 0 20px rgba(76, 201, 240, 0.3); }

/* Custom About Skills */
.skills-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 2rem;
    margin-top: 2.5rem;
}

.skill-item h4 {
    font-size: 0.85rem;
    text-transform: uppercase;
    letter-spacing: 2px;
    margin-bottom: 12px;
    color: var(--clr-primary);
}

.progress-line {
    height: 8px;
    background: rgba(255, 255, 255, 0.05);
    border-radius: 20px;
    position: relative;
    overflow: hidden;
}

.progress-line span {
    height: 100%;
    display: block;
    border-radius: 20px;
    background: linear-gradient(90deg, var(--clr-primary), var(--clr-accent));
    box-shadow: 0 0 15px var(--clr-primary);
    width: 0; 
    animation: fillBar 2s ease-out forwards;
}

@keyframes fillBar { from { width: 0; } }
.contact-page { padding: 6rem 0; }

.contact-wrapper {
    display: grid;
    grid-template-columns: 1fr 1.5fr;
    gap: 3rem;
    background: var(--glass);
    padding: 3rem;
    border-radius: 40px;
    border: 1px solid rgba(255, 255, 255, 0.1);
    box-shadow: var(--shadow);
}

.contact-info h2 { font-size: 2.5rem; margin-bottom: 1rem; color: var(--clr-primary); }
.contact-info p { color: var(--clr-muted); margin-bottom: 2rem; }

.info-item {
    display: flex;
    align-items: center;
    gap: 1.5rem;
    margin-bottom: 1.5rem;
}

.info-item .icon {
    width: 50px;
    height: 50px;
    background: rgba(76, 201, 240, 0.1);
    color: var(--clr-primary);
    display: flex;
    align-items: center;
    justify-content: center;
    border-radius: 12px;
    font-size: 1.2rem;
}

/* Contact Form */
.contact-form { display: flex; flex-direction: column; gap: 1.2rem; }
.form-group { position: relative; }
.contact-form input, .contact-form textarea {
    width: 100%;
    padding: 1rem 1.5rem;
    background: rgba(255, 255, 255, 0.05);
    border: 1px solid rgba(255, 255, 255, 0.1);
    border-radius: 15px;
    color: white;
    outline: none;
    transition: var(--transition);
}

.contact-form input:focus, .contact-form textarea:focus {
    border-color: var(--clr-primary);
    background: rgba(255, 255, 255, 0.1);
}

.contact-form textarea { height: 150px; resize: none; }
/* =========================================
   5. ANIMATIONS & FOOTER
   ========================================= */
@keyframes fadeInUp {
    from { opacity: 0; transform: translateY(30px); }
    to { opacity: 1; transform: translateY(0); }
}

footer { padding: 4rem; text-align: center; color: var(--clr-muted); border-top: 1px solid rgba(255, 255, 255, 0.05); }

@media (max-width: 768px) {
    .hero h1 { font-size: 3rem; }
    .stats-bar { grid-template-columns: 1fr; gap: 2rem; }
    .btn-outline { margin-left: 0; margin-top: 1rem; width: 100%; }
}
// Navigasi responsif (untuk mobile)
const navSlide = () => {
    const burger = document.querySelector('.burger');
    const nav = document.querySelector('.nav-links');
    
    if (burger) {
        burger.addEventListener('click', () => {
            nav.classList.toggle('nav-active');
        });
    }
}

// Efek scroll smooth
document.querySelectorAll('a[href^="#"]').forEach(anchor => {
    anchor.addEventListener('click', function (e) {
        e.preventDefault();
        document.querySelector(this.getAttribute('href')).scrollIntoView({
            behavior: 'smooth'
        });
    });
});

navSlide();

